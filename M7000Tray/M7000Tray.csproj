<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>M7000Tray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\M7000.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.2-dev.22" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7463" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\M7000Lib\M7000Lib.csproj" />
    <Content Include="Assets\envelope.png;Assets\M7000.ico;Assets\app.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- dotnet publish в unpackaged-режиме теряет PRI и .xbf (скомпилированный XAML) — без них крэш на старте. -->
  <Target Name="CopyXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <CompiledXaml Include="$(OutDir)$(TargetName).pri;$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(CompiledXaml)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
